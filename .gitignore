# Ignore everything by default; we explicitly opt-in only the folders we want.
*

# Keep this file itself and top-level project files in version control.
!.gitignore
!README.md
!AGENTS.md
!LICENSE
!install.sh

# Whitelist only these top-level folders and their contents.
!kitty/
!kitty/**
!lazygit/
!lazygit/**
!herdr/
!herdr/**
!karabiner/
!karabiner/**
!ghostty/
!ghostty/**
!git/
!git/**
!mise/
!mise/**
!dotfiles/
!dotfiles/**
!windows/
!windows/**
!wezterm/
!wezterm/**
!notes/
!notes/**

# --- herdr: exclude runtime / generated / machine-local files ---
herdr/*.log
herdr/*.sock*
herdr/session.json
herdr/session-history.json
herdr/session-snapshots/
herdr/release-notes.json
herdr/.plugins.lock
herdr/plugins/

# --- kitty: exclude backup files ---
kitty/*.bak

# --- lazygit: only config.yml is tracked; state.yml / logs stay machine-local ---
lazygit/state.yml
lazygit/*.log

# --- karabiner: machine-local backups; nested .git removed so parent repo tracks config ---
karabiner/automatic_backups/

# --- git: identity, credentials, machine-local UI; nested .git removed so parent tracks config ---
git/.git/
git/config.local
git/kvoon9
git/gitk

# --- dotfiles: exclude secrets / installer state / machine-local symlinks ---
# windows/.bashrc now lives at dotfiles/.bashrc.win (shared via dotfiles), windows/ kept only for .secrets.bash
windows/.secrets.bash
dotfiles/.secrets.zsh
dotfiles/.secrets.bash
dotfiles/.agents/.skill-lock.json
dotfiles/.agents/skills/terminal-browser
dotfiles/.agents/skills/ego-browser
