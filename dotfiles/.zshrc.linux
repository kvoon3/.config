# Linux/WSL counterpart of dotfiles/.zshrc (macOS). Deployed to ~/.zshrc by
# mise/config.linux.toml. Keep macOS-only paths and commands out of this file.
#
# The macOS file keeps the Mac-only aliases (iCloud Obsidian vault, Homebrew
# nginx, /Applications) and Mac mise/pnpm paths; this one follows
# dotfiles/.bashrc.linux instead: mise from ~/.local/bin, no proxy.sh (WSL has
# no local Clash listener), and Linux-native paths.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="spaceship"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-z)

alias zshconfig='nvim ~/.zshrc'
alias vimrc='nvim ~/.code.vimrc'
alias nvimconfig='nvim ~/.config/nvim'
alias gitconfig='nvim ~/.config/git'
alias ss='cat package.json | jq ".scripts"'
alias vr="vp run"
alias gcl='gh repo clone'
alias gl='git log --oneline --graph'
alias glp='git log -p'
alias gll='git log --graph --all --pretty=format:"%C(magenta)%h %C(white) %an  %ar%C(blue)  %D%n%s%n"'
alias ggp='git grep'
alias ggpa='git grep -npW'
alias gai='git add -i'

# Keep XDG and mise anchored in the Linux home even when the shell starts on
# /mnt/c; see the same block in .bashrc.linux.
export MISE_IGNORED_CONFIG_PATHS="/mnt/c/Users/*/.config/mise/config.toml"
export XDG_CONFIG_HOME="$HOME/.config"

case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

source "$HOME/.config/dotfiles/mirrors.sh"
source "$HOME/.config/dotfiles/aliases.sh"
source "$HOME/.config/dotfiles/functions.sh"

fpath=("$HOME/.zsh/completions" $fpath)
source $ZSH/oh-my-zsh.sh

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

[ -f "$HOME/.config/dotfiles/.secrets.zsh" ] && source "$HOME/.config/dotfiles/.secrets.zsh"

# Workaround: terminal-browser v0.13.4 runs `action` passthrough without --cdp,
# so agent-browser drives its own blank Chrome instead of the terminal browser,
# silently (empty snapshots, clicks going nowhere). The wrapper re-adds --cdp
# and lives in dotfiles/bin. See zenbu-labs/terminal-browser#60; remove both
# this export and dotfiles/bin/terminal-browser-ab-cdp once that is fixed.
export TERMINAL_BROWSER_AGENT="$HOME/.config/dotfiles/bin/terminal-browser-ab-cdp"

