{
  "mcpServers": {
    "magpie-web-search": {
      "command": "/Applications/magpie.app/Contents/MacOS/magpie",
      "args": [
        "mcp",
        "search"
      ]
    },
    "magpie-vision": {
      "command": "/Applications/magpie.app/Contents/MacOS/magpie",
      "args": [
        "mcp",
        "vision"
      ]
    },
    "magpie-memory": {
      "command": "/Applications/magpie.app/Contents/MacOS/magpie",
      "args": [
        "mcp",
        "memory"
      ]
    },
    "magpie-image": {
      "command": "/Applications/magpie.app/Contents/MacOS/magpie",
      "args": [
        "mcp",
        "image"
      ]
    },
    "android-use-by-andromeld": {
      "command": "/Applications/AndroMeld.app/Contents/MacOS/andromeld-mcp-server",
      "args": []
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ]
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
