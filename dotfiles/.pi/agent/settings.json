{
  "defaultModel": "deepseek-v4.1-flash",
  "defaultProvider": "workbuddy",
  "packages": [
    "npm:pi-commandcode-provider",
    "npm:pi-simplify",
    "npm:pi-terminal-theme",
    "npm:pi-diff-review",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/earendil-works/pi-review",
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:pi-tool-display",
    "npm:pi-language-tutor",
    "git:github.com/kvoon3/pi-review-loop",
    "npm:@ff-labs/pi-fff",
    {
      "source": "git:github.com/kvoon3/pi-extensions",
      "extensions": [
        "pi-minimal-footer/index.ts",
        "pi-split-fork/index.ts",
        "pi-kitty-notify/index.ts",
        "pi-workbuddy/index.ts"
      ],
      "skills": []
    },
    {
      "source": "git:github.com/ogulcancelik/pi-extensions",
      "extensions": [
        "packages/pi-herdr/index.ts",
        "packages/pi-session-recall/session-recall.ts",
        "packages/pi-quit-and-delete/index.ts",
        "packages/pi-codex-subagents/index.ts",
        "packages/pi-herdr-worktree-jump/index.ts"
      ],
      "skills": []
    }
  ],
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"\n[ -f \"$HOME/.config/dotfiles/functions.sh\" ] && source \"$HOME/.config/dotfiles/functions.sh\"",
  "lastChangelogVersion": "0.85.1",
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "vitesse-light-soft/vitesse-black",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "images": {
    "blockImages": false
  },
  "vstack": {
    "extensionManager": {
      "disabledItems": [],
      "config": {}
    }
  },
  "quietStartup": false,
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "tuiMode": "fullscreen",
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true
}
