#!/bin/sh
# Git credential helper for GitHub, wired up by the [credential] block in
# dotfiles/.gitconfig.
#
# `gh auth git-credential` always answers as the *active* gh account, so a push
# to a kvoon3 repo fails while kvoon9 is active (403 on kvoon3/nvim) and the
# other way round. gh holds both tokens and `gh auth token -u <account>` reads
# either one no matter which is active, so resolve the account from the owner in
# the requested URL path (hence useHttpPath) and print that token. Anything
# else — gists, orgs, other people's repos — exits silently so the next helper
# in the list (gh's own) still answers.

[ "$1" = get ] || exit 0

owner=$(sed -n 's|^path=\([^/]*\)/.*|\1|p')
case "$owner" in
  kvoon3 | kvoon9) ;;
  *) exit 0 ;;
esac

token=$(gh auth token -u "$owner" 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0

printf 'username=%s\npassword=%s\n' "$owner" "$token"
